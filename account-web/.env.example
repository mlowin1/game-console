# Defaults shown for local development; use HTTPS behind a trusted reverse proxy in production.
PORT=3001
PUBLIC_ORIGIN=http://localhost:3001
ACCOUNT_DB_PATH=./data/accounts.db
NODE_ENV=development
REQUIRE_EMAIL_VERIFICATION=false
DEV_LOG_VERIFICATION_LINKS=false
# SMTP_URL is reserved for a future SMTP adapter. Verification-required mode must not
# be enabled for production until a delivery adapter has been installed.
SMTP_URL=
